# Copy to .env.local — never commit .env.local
#
# Staging (recommended for team dev): use staging Supabase + staging Railway API.
# Prod values are only for debugging production issues — do not use for daily dev.

# Staging API (Railway staging service URL, or http://localhost:8765 if running API locally)
NEXT_PUBLIC_API_URL=https://YOUR-STAGING-API.up.railway.app

# Staging Supabase project (separate from production)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Local auth bypass for Analyze testing without signing in
NEXT_PUBLIC_DEV_BYPASS_AUTH=true
